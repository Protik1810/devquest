{
  "name": "devquest",
  "productName": "DevQuest",
  "version": "0.6.1",
  "description": "DevQuest: a gamified all-in-one software engineering academy. Created and developed by Protik.",
  "author": "Protik",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-runtimes.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win -c.electronDist=node_modules/electron/dist",
    "dist:linux": "npm run build && electron-builder --linux",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "verify:export": "node scripts/export-exercises.mjs",
    "verify:native": "node scripts/export-exercises.mjs && node scripts/verify-native.cjs",
    "fetch:runtimes": "node scripts/fetch-runtimes.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "android:release": "npm run android:sync && cd android && gradlew.bat assembleRelease bundleRelease",
    "share": "node scripts/share.mjs",
    "build:web": "npm run build && node scripts/downloads.mjs --copy dist/downloads",
    "verify:python": "node scripts/verify-python.mjs",
    "verify:js": "node scripts/verify-js.mjs"
  },
  "build": {
    "appId": "com.protik.devquest",
    "productName": "DevQuest",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "!dist/downloads/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "legalTrademarks": "DevQuest by Protik"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "Protik",
      "vendor": "Protik",
      "synopsis": "Gamified software engineering academy by Protik"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DevQuest"
    },
    "copyright": "Copyright © 2026 Protik",
    "icon": "build/icon.png"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/share": "^8.0.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@electric-sql/pglite": "^0.3.7",
    "@uiw/react-codemirror": "^4.25.12",
    "fengari-web": "^0.1.4",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.14.2",
    "sucrase": "^3.35.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^3.2.4",
    "wait-on": "^9.5.1"
  }
}
